rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only access their own data
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Telegram bot linking: users can create their own link codes
    match /telegramLinkCodes/{code} {
      allow create, delete: if request.auth != null && request.auth.uid == request.resource.data.uid;
    }

    // Telegram user mappings: only writable by Admin SDK (bot), not by client
    match /telegramUsers/{chatId} {
      allow get, list: if false;
      allow create, update, delete: if false;
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
